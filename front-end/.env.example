# Copy this file to .env and set values for your own environment.
# Do not commit .env or put secrets in VITE_ variables.

# API base URL used outside production mode (for example, local development).
VITE_APP_BASE_URL_LOCAL=https://your-backend.example.com/api

# API base URL used for production builds.
VITE_APP_BASE_URL_PRODUCTION=https://your-production-backend.com/api

# Base server origin used by parts of the application.
VITE_BASE_SERVER_URL=https://your-backend.example.com
